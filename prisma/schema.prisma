generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  WRITER
  EDITOR
  ADMIN
}

enum PostState {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String?            @unique
  emailVerified     DateTime?
  password          String?
  image             String?
  role              Role               @default(USER)
  stripeId          String?            @unique
  isSubscribed      Boolean            @default(false)
  giftLinks         Int                @default(0)
  posts             Post[]
  accounts          Account[]
  sessions          Session[]
  editorialNotes    EditorialNote[]
  favorites         Favorite[]
  pushSubscriptions PushSubscription[]
}

model Post {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  content        String?         @db.Text
  category       String
  state          PostState       @default(DRAFT)
  imageUrl       String?
  authorId       String
  author         User            @relation(fields: [authorId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publishedAt    DateTime?
  views          Int             @default(0)
  editorialNotes EditorialNote[]

  seoTitle          String?
  seoDescription    String?
  seoKeywords       String?
  keyInsights       String?        @db.Text
  featuredImageAlt  String?
  isPremium         Boolean        @default(false)
  isAmerica250      Boolean        @default(false)
  isBreaking        Boolean        @default(false)
  breakingUntil     DateTime?
  customAuthor      String?
  printEditionId    String?
  printEditionOrder Int?
  imageCaption      String?
  printEdition      PrintEdition?  @relation(fields: [printEditionId], references: [id])
  articleTokens     ArticleToken[]
  favorites         Favorite[]
}

model ArticleToken {
  id             String   @id @default(cuid())
  token          String   @unique
  email          String
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  isGift         Boolean  @default(false)
  giftedByUserId String?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PrintEdition {
  id            String          @id @default(cuid())
  title         String
  pdfUrl        String          @db.Text
  coverImageUrl String?         @db.Text
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  posts         Post[]
  purchases     PrintPurchase[]
}

model PrintPurchase {
  id              String        @id @default(cuid())
  email           String
  name            String?
  type            String        // digital | physical
  amount          Float
  stripeSessionId String?       @unique
  printEditionId  String?
  printEdition    PrintEdition? @relation(fields: [printEditionId], references: [id], onDelete: SetNull)
  shippingJson    String?       @db.Text
  fulfilled       Boolean       @default(false)
  createdAt       DateTime      @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
  isRead    Boolean  @default(false)
}

model Subscriber {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(true)
  wantsNews      Boolean  @default(true)
  wantsFaith     Boolean  @default(true)
  wantsOpinion   Boolean  @default(true)
  wantsVideos    Boolean  @default(true)
  wantsDigest    Boolean  @default(true)
  wantsInstant   Boolean  @default(false)
  wantsBreaking  Boolean  @default(true)
}

model EditorialNote {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Donation {
  id              String   @id @default(cuid())
  name            String?
  email           String
  amount          Float
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  userId        String?
  createdAt     DateTime @default(now())
  wantsNews     Boolean  @default(true)
  wantsFaith    Boolean  @default(true)
  wantsOpinion  Boolean  @default(true)
  wantsVideos   Boolean  @default(true)
  wantsBreaking Boolean  @default(true)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteSetting {
  key   String @id
  value String @db.Text
}

enum VideoPlatform {
  STREAM
  YOUTUBE
}

/// Curated short videos for home, article sidebar, and /videos.
/// Stream = Cloudflare Stream (on-site, no social login).
/// YouTube = paste link (also playable on-site via embed).
model Video {
  id            String        @id @default(cuid())
  title         String
  /// Public URL segment: /videos/[slug]
  slug          String        @unique
  description   String?       @db.Text
  /// SEO-optimized title (meta / OG); falls back to title
  seoTitle      String?
  /// Comma-separated keywords for meta + schema
  seoKeywords   String?
  platform      VideoPlatform
  /// Cloudflare Stream UID or YouTube video id
  externalId    String
  /// Original YouTube URL when platform is YOUTUBE
  sourceUrl     String?
  embedUrl      String
  thumbnailUrl  String?
  /// Canonical watch / content URL for SEO (VideoObject)
  contentUrl    String?
  durationSec   Int?
  /// Source pixel size when known (Stream input / YouTube) — drives player aspect
  width         Int?
  height        Int?
  /// Page views on /videos/[slug]
  views         Int           @default(0)
  isActive      Boolean       @default(true)
  showOnHome    Boolean       @default(true)
  showInSidebar Boolean       @default(true)
  sortOrder     Int           @default(0)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isActive, showOnHome, sortOrder])
  @@index([isActive, showInSidebar, sortOrder])
  @@index([publishedAt])
}
